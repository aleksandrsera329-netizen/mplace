NODE_ENV=production
PORT=3000

# Used by docker-compose postgres service
POSTGRES_USER=mplace
POSTGRES_PASSWORD=mplace
POSTGRES_DB=mplace

# Docker Compose (api service overrides host to "postgres")
DATABASE_URL=postgresql://mplace:mplace@postgres:5432/mplace?schema=public
# Local API without Docker (SQLite): change schema.prisma provider to sqlite and use:
# DATABASE_URL=file:./dev.db

JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://127.0.0.1,http://localhost,http://127.0.0.1:8080,http://localhost:8080

REDIS_URL=redis://redis:6379
# Local without Docker:
# REDIS_URL=redis://127.0.0.1:6379

# Payments
# production: PAYMENT_PROVIDER=stripe and set Stripe keys
# local/docker demo: PAYMENT_PROVIDER=dev + ALLOW_DEV_PAYMENTS=true
PAYMENT_PROVIDER=dev
ALLOW_DEV_PAYMENTS=true
LOCAL_DEV_CONFIRM_LOOPBACK=true
DEV_PAYMENT_SECRET=change_me_never_in_frontend

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# docker compose up -d --build
# Site: http://127.0.0.1/  API: http://127.0.0.1/api/health
