NODE_ENV=development
PORT=3000

DATABASE_URL=file:./dev.db
# Production:
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/mplace?schema=public

JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

REDIS_URL=redis://127.0.0.1:6379

# Payments
# production: PAYMENT_PROVIDER=stripe and set Stripe keys
# local only: PAYMENT_PROVIDER=dev + ALLOW_DEV_PAYMENTS=true
PAYMENT_PROVIDER=dev
ALLOW_DEV_PAYMENTS=true
LOCAL_DEV_CONFIRM_LOOPBACK=true
DEV_PAYMENT_SECRET=change_me_never_in_frontend

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
