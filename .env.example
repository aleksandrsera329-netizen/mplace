# Local / docker-compose development template
# For production secrets see .env.production.example (Stage 4 fail-fast)

NODE_ENV=development
PORT=3000

# Used by docker-compose postgres service (local defaults only — NOT for production)
POSTGRES_USER=mplace
POSTGRES_PASSWORD=mplace
POSTGRES_DB=mplace

# Docker Compose (api service overrides host to "postgres")
DATABASE_URL=postgresql://mplace:mplace@postgres:5432/mplace?schema=public
# Local API without Docker:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mplace?schema=public

# Must be set (any long string in dev). Production requires >=32 non-default chars.
JWT_SECRET=dev_only_change_me_to_a_long_random_secret_at_least_32
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://127.0.0.1,http://localhost,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8088,http://localhost:8088,http://127.0.0.1:3000,http://localhost:3000

REDIS_URL=redis://redis:6379
# Local without Docker:
# REDIS_URL=redis://127.0.0.1:6379

# Meilisearch (product full-text search) — local demo key only
MEILI_MASTER_KEY=masterKeyChangeMe_at_least_16_chars
MEILISEARCH_URL=http://meilisearch:7700
# Local API outside Docker: http://127.0.0.1:7700
MEILISEARCH_API_KEY=masterKeyChangeMe_at_least_16_chars

# Storage (S3 / Cloudflare R2)
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=mplace-media
# STORAGE_PUBLIC_URL=https://media.yourdomain.com
# STORAGE_SIGN_SECRET=

# Payments
# production: PAYMENT_PROVIDER=stripe + STRIPE_* (required; fail-fast)
# local/docker: PAYMENT_PROVIDER=dev + ALLOW_DEV_PAYMENTS=true
PAYMENT_PROVIDER=dev
ALLOW_DEV_PAYMENTS=true
LOCAL_DEV_CONFIRM_LOOPBACK=true
DEV_PAYMENT_SECRET=dev_only_never_in_frontend

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_COMMISSION_PERCENT=10

# Notifications
NOTIFICATION_CHANNEL=log
APP_PUBLIC_URL=http://127.0.0.1:8088

# docker compose up -d --build
# Site: http://127.0.0.1:8088/  API: http://127.0.0.1:3001/api/health

# Local/non-production demo seed only; never set in production.
# Empty DEMO_PASSWORD → seed uses 123456 (spec local/dev).
DEMO_PASSWORD=
ALLOW_DEMO_LOGIN=true
