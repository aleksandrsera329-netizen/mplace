// Mplace marketplace data model — TZ Epic 1–4 foundation

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  // Production / docker-compose: PostgreSQL
  // Local SQLite: set provider back to "sqlite" and DATABASE_URL=file:./dev.db
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MERCHANT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DisputeStatus {
  OPEN
  APPEALED
  RESOLVED
  CLOSED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum LedgerAccount {
  PLATFORM
  VENDOR
  CUSTOMER_HOLD
  EXTERNAL
}

enum LedgerEntryType {
  ORDER_PAYMENT
  COMMISSION
  VENDOR_EARNING
  PAYOUT
  REFUND
  ADJUSTMENT
  DEPOSIT
}

enum KycDocType {
  PASSPORT
  INN
  CHARTER
  CERTIFICATE
  OTHER
}

enum KycDocStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RfqStatus {
  DRAFT
  OPEN
  MATCHED
  QUOTED
  AWARDED
  CLOSED
  CANCELLED
}

enum RfqOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  phone                String?    @unique
  passwordHash         String
  name                 String
  company              String?
  role                 UserRole
  status               UserStatus @default(ACTIVE)
  emailVerifiedAt      DateTime?
  phoneVerifiedAt      DateTime?
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  twoFactorEnabled     Boolean    @default(false)
  twoFactorSecret      String?
  shopId               String?    @unique
  shop                 Shop?      @relation(fields: [shopId], references: [id])
  orders               Order[]    @relation("CustomerOrders")
  tickets              Ticket[]   @relation("TicketAuthor")
  ticketMsgs           TicketMessage[]
  auditLogs            AuditLog[]
  statusChanges        OrderStatusHistory[]
  refreshTokens        RefreshToken[]
  kycDocuments         KycDocument[] @relation("KycUploader")
  kycReviews           KycDocument[] @relation("KycReviewer")
  wishlists            WishlistItem[]
  savedSearches        SavedSearch[]
  rfqRequests          RfqRequest[]  @relation("RfqBuyer")
  rfqOffers            RfqOffer[]    @relation("RfqOfferVendor")
  rfqMessages          RfqMessage[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([role])
  @@index([status])
  @@index([phone])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model KycDocument {
  id           String       @id @default(cuid())
  shopId       String
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?        @relation("KycUploader", fields: [uploadedById], references: [id])
  reviewedById String?
  reviewedBy   User?        @relation("KycReviewer", fields: [reviewedById], references: [id])
  docType      KycDocType   @default(OTHER)
  fileName     String
  filePath     String
  status       KycDocStatus @default(PENDING)
  notes        String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([shopId, status])
}

model Shop {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?
  status          ShopStatus    @default(PENDING)
  verified        Boolean       @default(false)
  legalName       String?
  taxId           String?
  country         String?
  address         String?
  payoutDetails   String?
  kycNotes        String?
  rejectionReason String?

  // Stripe Connect (Express / Custom)
  stripeAccountId     String?   @unique
  stripeAccountStatus String? // currently_due, pending, enabled, restricted...
  stripeOnboardedAt   DateTime?
  chargesEnabled      Boolean   @default(false)
  payoutsEnabled      Boolean   @default(false)
  detailsSubmitted    Boolean   @default(false)

  owner           User?
  products        Product[]
  orders          Order[]
  payouts         PayoutRequest[]
  ledger          LedgerEntry[]
  kycDocuments    KycDocument[]
  rfqMatches      RfqMatch[]
  rfqOffers       RfqOffer[]
  stripeConnected StripeConnectedAccount?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

/// History / snapshot of Connect onboarding for a shop
model StripeConnectedAccount {
  id               String   @id @default(cuid())
  shopId           String   @unique
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stripeAccountId  String   @unique
  type             String   @default("express") // express | standard | custom
  status           String?
  chargesEnabled   Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)
  detailsSubmitted Boolean  @default(false)
  raw              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  rfqItems  RfqItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id          String         @id @default(cuid())
  shopId      String
  shop        Shop           @relation(fields: [shopId], references: [id])
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id])
  name        String
  slug        String
  description String?
  imageUrl    String?
  sku         String?
  gtin        String?
  priceCents  Int
  currency    String         @default("USD")
  stock       Int            @default(0)
  soldCount   Int            @default(0)
  viewsCount  Int            @default(0)
  status      ProductStatus  @default(DRAFT)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  images      ProductImage[]
  documents   ProductDocument[]
  wishlists   WishlistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([shopId, slug])
  @@index([status])
  @@index([shopId])
  @@index([categoryId])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  sortOrder   Int      @default(0)
  isMain      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  filePath  String
  docType   String   @default("certificate")
  createdAt DateTime @default(now())

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  queryJson String
  createdAt DateTime @default(now())

  @@index([userId])
}

model RfqRequest {
  id          String          @id @default(cuid())
  number      String          @unique
  buyerId     String
  buyer       User            @relation("RfqBuyer", fields: [buyerId], references: [id])
  title       String
  description String?
  status      RfqStatus       @default(DRAFT)
  deadline    DateTime?
  currency    String          @default("USD")
  items       RfqItem[]
  attachments RfqAttachment[]
  matches     RfqMatch[]
  offers      RfqOffer[]
  messages    RfqMessage[]
  awardedOfferId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([buyerId, status])
  @@index([status])
  @@index([deadline])
}

model RfqItem {
  id          String    @id @default(cuid())
  rfqId       String
  rfq         RfqRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int       @default(1)
  unit        String?   @default("pcs")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  specs       String?
  offerItems  RfqOfferItem[]

  @@index([rfqId])
}

model RfqAttachment {
  id        String     @id @default(cuid())
  rfqId     String
  rfq       RfqRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  createdAt DateTime   @default(now())

  @@index([rfqId])
}

model RfqMatch {
  id        String     @id @default(cuid())
  rfqId     String
  rfq       RfqRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  shopId    String
  shop      Shop       @relation(fields: [shopId], references: [id])
  score     Int        @default(0)
  reason    String?
  createdAt DateTime   @default(now())

  @@unique([rfqId, shopId])
  @@index([shopId])
}

model RfqOffer {
  id          String         @id @default(cuid())
  rfqId       String
  rfq         RfqRequest     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  shopId      String
  shop        Shop           @relation(fields: [shopId], references: [id])
  vendorId    String
  vendor      User           @relation("RfqOfferVendor", fields: [vendorId], references: [id])
  status      RfqOfferStatus @default(PENDING)
  message     String?
  totalCents  Int            @default(0)
  currency    String         @default("USD")
  validUntil  DateTime?
  items       RfqOfferItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([rfqId, shopId])
  @@index([shopId, status])
}

model RfqOfferItem {
  id             String  @id @default(cuid())
  offerId        String
  offer          RfqOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  rfqItemId      String
  rfqItem        RfqItem  @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)
  unitPriceCents Int
  quantity       Int      @default(1)
  note           String?
  alternative    String?

  @@unique([offerId, rfqItemId])
}

model RfqMessage {
  id        String     @id @default(cuid())
  rfqId     String
  rfq       RfqRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?      @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime   @default(now())

  @@index([rfqId, createdAt])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  sessionKey String?    @unique
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model Order {
  id                    String               @id @default(cuid())
  orderNumber           String               @unique
  customerId            String?
  customer              User?                @relation("CustomerOrders", fields: [customerId], references: [id])
  shopId                String
  shop                  Shop                 @relation(fields: [shopId], references: [id])
  status                OrderStatus          @default(PENDING_PAYMENT)
  currency              String               @default("USD")
  subtotalCents         Int
  commissionCents       Int                  @default(0)
  totalCents            Int
  customerEmail         String?
  customerName          String?
  paymentTokenHash      String?
  paymentTokenExpiresAt DateTime?
  items                 OrderItem[]
  payments              Payment[]
  statusHistory         OrderStatusHistory[]
  disputes              Dispute[]
  refunds               Refund[]
  ledger                LedgerEntry[]
  paymentRef            String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status])
  @@index([shopId])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  productName    String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id])
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  currency          String        @default("USD")
  idempotencyKey    String        @unique
  paidAt            DateTime?
  rawPayload        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  shopId      String?
  shop        Shop?           @relation(fields: [shopId], references: [id])
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  account     LedgerAccount
  entryType   LedgerEntryType
  amountCents Int
  currency    String          @default("USD")
  description String?
  metadata    String?
  createdAt   DateTime        @default(now())

  @@index([shopId])
  @@index([orderId])
  @@index([account, entryType])
  @@index([createdAt])
}

model PayoutRequest {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id])
  amountCents Int
  currency    String       @default("USD")
  status      PayoutStatus @default(PENDING)
  method      String       @default("bank")
  note        String?
  adminNote   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([shopId, status])
}

model Ticket {
  id        String          @id @default(cuid())
  authorId  String?
  author    User?           @relation("TicketAuthor", fields: [authorId], references: [id])
  subject   String
  body      String
  type      String          @default("general")
  priority  TicketPriority  @default(NORMAL)
  status    TicketStatus    @default(OPEN)
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@index([priority])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Dispute {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id])
  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([orderId])
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  amountCents Int
  reason      String?
  status      RefundStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  ip         String?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
