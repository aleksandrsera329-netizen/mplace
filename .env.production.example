# Copy to deployment secrets manager — never commit real values.
NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://mplace:CHANGE_ME@db:5432/mplace?schema=public
JWT_SECRET=GENERATE_RANDOM_64_CHAR_SECRET
JWT_EXPIRES_IN=15m
CORS_ORIGINS=https://your-domain.example

REDIS_URL=redis://redis:6379

# Production: Stripe only — never "dev"
PAYMENT_PROVIDER=stripe
ALLOW_DEV_PAYMENTS=false
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Do not set DEV_PAYMENT_SECRET in production
