# =============================================================================
# Production secrets template — copy to secret manager / .env.production
# NEVER commit real values. NEVER use the placeholder strings below.
# =============================================================================

NODE_ENV=production
PORT=3000

# Strong password only — weak defaults (mplace, password, postgres) are rejected at boot
DATABASE_URL=postgresql://mplace:STRONG_DB_PASSWORD_HERE@db:5432/mplace?schema=public
POSTGRES_USER=mplace
POSTGRES_PASSWORD=STRONG_DB_PASSWORD_HERE
POSTGRES_DB=mplace

# >= 32 random chars; values containing change_me / dev-secret are rejected
JWT_SECRET=GENERATE_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=15m

CORS_ORIGINS=https://your-domain.example
APP_PUBLIC_URL=https://your-domain.example

REDIS_URL=redis://redis:6379

# Meilisearch — not the compose demo key
MEILI_MASTER_KEY=LONG_RANDOM_KEY_AT_LEAST_32_CHARS
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=LONG_RANDOM_KEY_AT_LEAST_32_CHARS

# Payments — stripe only in production (PAYMENT_PROVIDER=dev is rejected)
PAYMENT_PROVIDER=stripe
ALLOW_DEV_PAYMENTS=false
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Storage
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=r2
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_PUBLIC_URL=
# Optional dedicated signer for private downloads (defaults to JWT_SECRET)
# STORAGE_SIGN_SECRET=

# Optional
# SENTRY_DSN=
